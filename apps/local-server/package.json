{
  "name": "@kumon-siso/local-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/static": "^6.12.0",
    "@kumon-siso/database": "1.0.0",
    "@kumon-siso/import": "1.0.0",
    "@kumon-siso/shared": "1.0.0",
    "@kumon-siso/sms-adapters": "1.0.0",
