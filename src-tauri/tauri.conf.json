{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Kumon SISO",
  "version": "1.0.0",
  "identifier": "com.kumon-siso.desktop",
  "build": {
    "frontendDist": "../apps/desktop-admin/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev:admin",
    "beforeBuildCommand": "npm run build && npm run build:sidecar"
  },
  "app": {
    "title": "Kumon SISO - Student Check-In & Pickup System",
    "windows": [
      {
        "title": "Kumon SISO",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kumon-siso-server"
    ],
    "resources": [
      "resources/**/*"
    ]
  }
}
